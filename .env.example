# Copy this file to `.env` (git-ignored) and fill in real values. Never commit `.env`.
# Variables are grouped by the phase that first needs them; the API validates them on startup.

# --- Phase 0: API server ---------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Phase 1: database + auth ----------------------------------------------
# Local: the Docker Compose Postgres below. Production: Supabase *session pooler* URL.
DATABASE_URL=postgres://debrief:debrief@localhost:5432/debrief
# Tests always use local Docker Postgres, never Supabase.
TEST_DATABASE_URL=postgres://debrief:debrief@localhost:5432/debrief_test
# Supabase *session pooler* URL (Supabase → Connect → Direct → Session pooler, port 5432).
# Only used by `npm run db:migrate:supabase`; local dev and tests never use it. Connections are
# verified against apps/api/certs/supabase-root-2021-ca.crt. On Render, DATABASE_URL is this URL.
SUPABASE_DATABASE_URL=
# The browser origin allowed to send non-GET requests (CSRF Origin check).
WEB_ORIGIN=http://localhost:5173
# Number of proxies in front of the api (0 locally; Docker Compose and Render set their own).
TRUST_PROXY=0

# --- Phase 3: AI (OpenRouter) ----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-replace-me
# OpenRouter model ids, tried in order. Free models end in ":free".
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
# Optional; leave empty to use free models only.
AI_MODEL_PAID_FALLBACK=
# Sent to OpenRouter as HTTP-Referer to identify the app.
APP_URL=http://localhost:5173

# --- Phase 5: Google Calendar integration (optional: the app works without it) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
