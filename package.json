{
  "name": "debrief",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d --wait db && npm run db:migrate && concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @debrief/api",
    "dev:web": "npm run dev -w @debrief/web",
    "build": "npm run build -w @debrief/web && node scripts/write-netlify-redirects.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @debrief/api",
    "db:migrate": "npm run db:migrate -w @debrief/api",
    "db:migrate:supabase": "npm run db:migrate:supabase -w @debrief/api",
    "ai:eval": "npm run ai:eval -w @debrief/api --",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
